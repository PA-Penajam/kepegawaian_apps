APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

APP_LOG_SLOW_QUERIES=false
APP_SLOW_QUERY_THRESHOLD_MS=500

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Otomatis bernilai true pada production/HTTPS. Isi false hanya jika terpaksa berjalan di HTTP lokal.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Penyimpanan Google Drive (OAuth 2.0 Playground)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=

VITE_APP_NAME="${APP_NAME}"

# SSO PA Penajam (OAuth2 Server / Identity Provider) — https://sso-papenajam.test/integrasi-dokumentasi
# Base URL harus tanpa trailing slash. Contoh prod: https://sso-papenajam.test
SSO_BASE_URL=https://sso-papenajam.test
# Client ID/Secret dari Filament → Aplikasi OAuth (Client) di sso-papenajam. Secret hanya tampil sekali.
SSO_CLIENT_ID=kepegawaian-apps
SSO_CLIENT_SECRET=
# Redirect harus exact match dengan yang terdaftar di SSO (skema+host+path).
SSO_REDIRECT_URI="${APP_URL}/auth/sso/callback"
SSO_REQUEST_TIMEOUT=5
SSO_REFRESH_BEFORE_SECONDS=60
SSO_STATE_EXPIRY_MINUTES=10
# Scope default: profile email (jangan tambahkan openid — SSO tidak mengenalinya, akan invalid_scope)
SSO_SCOPES="profile email"

# Integrasi API kepegawaian (sso-papenajam, wfa-task, attendance-qr-system)
# Nilainya harus SAMA dengan KEPEGAWAIAN_HMAC_SECRET di .env tiap aplikasi konsumen.
# Generate dengan: php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
KEPEGAWAIAN_HMAC_SECRET=

# IAM SSO Gateway Configuration
# Generate dengan: php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
IAM_TOKEN_TTL_HOURS=8
IAM_SSO_CODE_TTL=60
IAM_APP_SLUG=kepegawaian

# Seeder credentials (WAJIB diisi di production; kosong = fallback default dev admin123/operator123)
SEEDER_ADMIN_PASSWORD=
SEEDER_OPERATOR_PASSWORD=

# URL aplikasi attendance yang diregistrasi AttendanceAppSeeder
ATTENDANCE_APP_URL=http://localhost:3000

# Mode Pengembangan Modul (true = modul di luar Cuti, Data Pegawai, Dashboard & Konfigurasi tampil sebagai "Dalam Pengembangan")
MODULES_UNDER_DEVELOPMENT_ENABLED=true
MODULE_SELF_SERVICE_UNDER_DEVELOPMENT=true
MODULE_VALIDASI_PENGAJUAN_UNDER_DEVELOPMENT=true
MODULE_MONITORING_UNDER_DEVELOPMENT=true
MODULE_KENAIKAN_PANGKAT_UNDER_DEVELOPMENT=true

# Reverse proxy internal (CIDR Docker/Traefik/localhost) yang dipercaya untuk header X-Forwarded-* dan CF-Visitor
TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1
