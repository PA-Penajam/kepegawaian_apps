APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

APP_LOG_SLOW_QUERIES=false
APP_SLOW_QUERY_THRESHOLD_MS=500

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Keycloak IAM Configuration
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=kepegawaian
KEYCLOAK_CLIENT_ID=kepegawaian-apps
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI="${APP_URL}/keycloak/callback"

# Keycloak Service Account (M2M / Admin API)
KEYCLOAK_SERVICE_CLIENT_ID=kepegawaian-service
KEYCLOAK_SERVICE_CLIENT_SECRET=

# Keycloak Token Settings
KEYCLOAK_REFRESH_BEFORE_SECONDS=60
KEYCLOAK_REQUEST_TIMEOUT=5
KEYCLOAK_STATE_EXPIRY_MINUTES=10

# Keycloak Circuit Breaker
KEYCLOAK_CB_FAILURE_THRESHOLD=5
KEYCLOAK_CB_RECOVERY_TIMEOUT=30
KEYCLOAK_CB_SUCCESS_THRESHOLD=2
KEYCLOAK_CB_CACHE_DRIVER=

# Keycloak Emergency Bypass
KEYCLOAK_EMERGENCY_ENABLED=false
KEYCLOAK_EMERGENCY_USERNAME=
KEYCLOAK_EMERGENCY_PASSWORD= # Harus berisi bcrypt hash (gunakan: php artisan tinker --execute "echo bcrypt('password')")
KEYCLOAK_EMERGENCY_SESSION_TIMEOUT=30
KEYCLOAK_EMERGENCY_ALLOWED_ROLES=admin
KEYCLOAK_EMERGENCY_RATE_LIMIT=5
KEYCLOAK_EMERGENCY_RATE_DECAY=15

# Keycloak Sync
KEYCLOAK_SYNC_WINDOW_HOURS=24
KEYCLOAK_SYNC_BATCH_SIZE=100

# Integrasi attendance-qr-system
# Generate dengan: php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
ATTENDANCE_HMAC_SECRET=

# IAM SSO Gateway Configuration
# Generate dengan: php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
IAM_TOKEN_TTL_HOURS=8
IAM_SSO_CODE_TTL=60
IAM_APP_SLUG=kepegawaian

# Seeder credentials (WAJIB diisi di production)
SEEDER_ADMIN_PASSWORD=
SEEDER_OPERATOR_PASSWORD=60
